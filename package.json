{
  "name": "windows-troubleshoot-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix bpc-management ci",
    "dev": "concurrently -k -n site,bpc \"next dev\" \"npm --prefix bpc-management run dev\"",
    "build": "npm --prefix bpc-management run build && next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node scripts/bpc-db.mjs setup",
    "db:import": "node scripts/bpc-db.mjs import",
    "test:bpc": "tsx --test tests/bpc-repository.test.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "file-saver": "^2.0.5",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-mdx-remote": "^6.0.0",
    "qrcode": "^1.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
